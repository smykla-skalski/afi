# afi multi-source configuration
# ------------------------------------------------------------------
# Copy these lines into ~/.env (or export them in your shell) to enable
# multiple model sources. afi auto-loads ~/.env at startup.
#
# Each source needs at minimum a BASE_URL. API_KEY and MODEL are optional:
#   - API_KEY defaults to "sk-noop" (local servers ignore it)
#   - MODEL left blank -> auto-resolved from the server's /v1/models
#
# API_KEY supports $indirection: $some_key means "look up the env var
# (or ~/.env key) named some_key". Useful when the key already lives
# somewhere and you don't want to duplicate it.

# Comma-separated list of source names. The first is the default at startup.
AFI_SOURCES=local,zai

# --- local: llama.cpp / vLLM on this machine ---------------------------
AFI_SOURCE_LOCAL_BASE_URL=http://localhost:8080/v1
AFI_SOURCE_LOCAL_API_KEY=sk-noop
# MODEL omitted -> auto-resolved from server
# How much context the server was started with (llama.cpp's -c). Nothing else
# can know this, and without it afi will not auto-compress this source. Set 0
# to turn folding off here while leaving it on elsewhere.
AFI_SOURCE_LOCAL_CONTEXT_WINDOW=32768

# --- zai: Z.ai remote endpoint -----------------------------------------
AFI_SOURCE_ZAI_BASE_URL=https://api.z.ai/api/paas/v4
AFI_SOURCE_ZAI_API_KEY=***         # pulls "zai_test" from ~/.env
AFI_SOURCE_ZAI_MODEL=glm-x-preview

# --- together: built-in convenience source (Together AI) ---------------
# If AFI_TOGETHER_API_KEY is set (here or in your shell), afi auto-registers a
# `together` source at https://api.together.xyz/v1 defaulting to GLM-5.2.
# No AFI_SOURCE_TOGETHER_* vars needed - just:
AFI_TOGETHER_API_KEY=***

# Together hosts many models, so /source takes an optional model override:
#   /source together                    # -> zai-org/GLM-5.2 (the default)
#   /source together zai-org/GLM-4.6    # -> any other Together model id
# It's registered last, so it never displaces your default startup source.
# Defining AFI_SOURCE_TOGETHER_* below overrides the built-in entirely:
# AFI_SOURCE_TOGETHER_BASE_URL=https://api.together.xyz/v1
# AFI_SOURCE_TOGETHER_API_KEY=$AFI_TOGETHER_API_KEY
# AFI_SOURCE_TOGETHER_MODEL=zai-org/GLM-5.2

# --- openrouter: built-in convenience source (OpenRouter) --------------
# If AFI_OPENROUTER_API_KEY is set (here or in your shell), afi auto-registers
# an `openrouter` source at https://openrouter.ai/api/v1 defaulting to
# z-ai/glm-5.2 routed to parasail/fp8 (no fallback). Provider routing can be
# controlled per-session with the /provider command:
#   /source openrouter                       # -> GLM-5.2 via parasail/fp8
#   /source openrouter z-ai/glm-4.6          # -> any other OpenRouter model id
#   /provider Together,DeepInfra             # re-route to specific providers
#   /provider off                            # clear routing, let OpenRouter pick
AFI_OPENROUTER_API_KEY=***

# --- anthropic: built-in source on the NATIVE Messages API -------------
# Unlike every source above, this one does not speak OpenAI-compatible
# /chat/completions. It uses Anthropic's POST /v1/messages, which gets you real
# tool_use blocks and prompt caching on the system prompt.
# Defaults to https://api.anthropic.com with claude-sonnet-5.
#
# Pick ONE of the three auth modes below. Precedence, if several are set, is
# api key -> bearer token -> federation, matching the official SDKs.
#
# The un-prefixed ANTHROPIC_* names are read deliberately, so a shell already
# set up for the Anthropic SDKs or the `ant` CLI works with no extra config.

# (1) Static API key. AFI_ANTHROPIC_API_KEY wins over ANTHROPIC_API_KEY, and
#     both support the same $indirection as the other sources.
ANTHROPIC_API_KEY=***

# (2) Pre-minted OAuth bearer token, e.g. from `ant auth print-credentials
#     --access-token`. Sent as Authorization: Bearer; x-api-key is then never
#     sent at all, which matters because the API validates x-api-key in
#     preference to the bearer and a wrong one fails the request outright.
# ANTHROPIC_AUTH_TOKEN=***

# (3) Workload identity federation: afi exchanges an OIDC identity token for a
#     short-lived access token itself and re-mints it near expiry. The three
#     ids are non-secret. WORKSPACE_ID is only needed when the federation rule
#     spans workspaces.
# ANTHROPIC_FEDERATION_RULE_ID=fdrl_...
# ANTHROPIC_ORGANIZATION_ID=...
# ANTHROPIC_SERVICE_ACCOUNT_ID=svac_...
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
#
#     The identity token comes from ANTHROPIC_IDENTITY_TOKEN, else
#     ANTHROPIC_IDENTITY_TOKEN_FILE, else GitHub Actions' OIDC endpoint - so in
#     a workflow with `permissions: id-token: write` there is nothing to set.

# Anthropic hosts many models, so /source takes an optional model override:
#   /source anthropic                   # -> claude-sonnet-5 (the default)
#   /source anthropic claude-opus-5     # -> any other Anthropic model id
# It's registered last, so it never displaces your default startup source.
#
# These tweak the built-in and stay outside the AFI_SOURCE_* namespace on
# purpose: a bare AFI_SOURCE_ANTHROPIC_BASE_URL is enough for afi to
# auto-discover a source named `anthropic`, and it would come up on the
# OpenAI-compatible protocol with no credential.
# AFI_ANTHROPIC_MODEL=claude-opus-5
# AFI_ANTHROPIC_BASE_URL=https://api.anthropic.com

# Sampling params are never sent to Anthropic (temperature/top_p/top_k are
# rejected there, and min_p/DRY are llama.cpp-only). EXTRA_BODY accepts only
# output_config, metadata, stop_sequences, service_tier, and thinking:
# AFI_ANTHROPIC_EXTRA_BODY={"output_config":{"effort":"high"}}
#
# Reasoning effort has a first-class control that needs no provider JSON and is
# translated for whichever source is active - see AFI_EFFORT at the bottom of
# this file. EXTRA_BODY wins where both set one.
#
# Thinking is sent as `disabled` unless EXTRA_BODY says otherwise. Disabled is
# the default because it is the one value every current model accepts:
# claude-haiku-4-5 rejects adaptive outright, and claude-opus-5 allows disabled
# only at effort `high` or below. Turn it on with an object; note `display`,
# whose API default (`omitted`) thinks and bills but returns no text:
# AFI_ANTHROPIC_EXTRA_BODY={"thinking":{"type":"adaptive","display":"summarized"}}
#
# JSON null omits the key entirely, which is what claude-fable-5 needs - it
# rejects an explicit `disabled` and always thinks:
# AFI_ANTHROPIC_EXTRA_BODY={"thinking":null}
#
# At effort xhigh or max the default gives way to omission: claude-opus-5
# rejects an explicit `disabled` that high. Anything set here is still sent as
# written.

# --- bedrock: built-in source on Amazon Bedrock ------------------------
# Bedrock's open-weight models are reached through its OpenAI-compatible
# /openai/v1/chat/completions, so the wire shape is the usual one. The
# credential is not: Bedrock takes no static key header and signs each request
# with AWS SigV4. Set AWS credentials and a Region and a `bedrock` source
# registers itself at https://bedrock-runtime.<region>.amazonaws.com/openai/v1
# with zai.glm-5.
#
# These are the names every AWS SDK and the `aws` CLI already read, so a shell
# that can run `aws bedrock` needs nothing else here. Nothing outside the
# environment is consulted - no shared credentials file, no profile, no
# instance metadata - so an SSO session has to be exported into it.
AWS_ACCESS_KEY_ID=***
AWS_SECRET_ACCESS_KEY=***
AWS_REGION=us-east-1
# Set by STS, SSO, and instance roles; absent for a long-lived IAM user.
# AWS_SESSION_TOKEN=***

# All three of the above are required together. A half-set refuses the run and
# names what is missing, rather than failing partway through a turn.
#
# Or hold no key at all: set AWS_ROLE_ARN and afi assumes that role from an
# OIDC identity token, so a workflow granting `permissions: id-token: write`
# stores no AWS credential anywhere. The Region is still required; the key pair
# is not. Register token.actions.githubusercontent.com as an IAM OIDC identity
# provider with audience sts.amazonaws.com, then condition the role's trust
# policy on the `sub` claim - afi supplies the token, the account decides what
# it is worth.
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/afi-ci
#
# Names the session in CloudTrail, so a call afi made is attributable past the
# role every job in the account shares. Defaults to `afi`.
# AWS_ROLE_SESSION_NAME=afi-pr-review
#
# Where the identity token comes from, if not GitHub Actions' own endpoint. The
# _FILE spelling is the variable every AWS SDK reads, so a job that has already
# run configure-aws-credentials, or an EKS pod identity, needs nothing here.
# AWS_WEB_IDENTITY_TOKEN_FILE=/var/run/secrets/eks.amazonaws.com/serviceaccount/token
# AWS_WEB_IDENTITY_TOKEN=***
#
# A complete static pair above wins over a role, matching every AWS SDK's
# default credential chain. Half a pair does not, so a misspelled secret does
# not take down a run that had a good role to assume. The run summary's
# auth.mode says which was used: sigv4, or sigv4_web_identity.
#
# AFI_BEDROCK_EXTRA_BODY takes any request-body keys this source should send:
# AFI_BEDROCK_EXTRA_BODY={"max_completion_tokens":512}

# Bedrock hosts many models, so /source takes an optional model override:
#   /source bedrock                                # -> zai.glm-5 (the default)
#   /source bedrock moonshotai.kimi-k2.5
#   /source bedrock qwen.qwen3-coder-30b-a3b-v1:0
#   /source bedrock openai.gpt-oss-20b-1:0
# Which of them will actually call tools through Bedrock is unconfirmed. A
# rejection ends the run either way, and one that offered tools says what a
# missing tool capability would mean - Bedrock gives afi no way to tell that
# apart from a malformed request, so it names the possibility, not a verdict.
# AFI_BEDROCK_MODEL=openai.gpt-oss-20b-1:0
#
# The endpoint override has to name the same Region as AWS_REGION above: the
# signature is scoped to that Region and posted to this host, and a mismatch is
# rejected. Keep the /openai/v1 prefix - Bedrock serves nothing at /v1 and
# answers UnknownOperationException there.
# AFI_BEDROCK_BASE_URL=https://bedrock-runtime.us-east-1.amazonaws.com/openai/v1

# Anthropic models on Bedrock are out of scope: the `anthropic` source above
# reaches those directly, with prompt caching and thinking blocks this path
# does not have.

# --- pointing some other endpoint at another protocol ------------------
# Any named source can switch protocol. Defaults to `openai`, so existing
# sources are unaffected. Accepts: openai, anthropic, anthropic-oauth,
# aws-bedrock-openai.
# AFI_SOURCE_GATEWAY_BASE_URL=https://gateway.internal/anthropic
# AFI_SOURCE_GATEWAY_API_KEY=***
# AFI_SOURCE_GATEWAY_PROTOCOL=anthropic

# A Bedrock source needs no BASE_URL - its Region supplies one - which makes it
# the one protocol a source can be discovered from on its own.
# AFI_SOURCE_AWS_PROTOCOL=aws-bedrock-openai
# AFI_SOURCE_AWS_MODEL=openai.gpt-oss-20b-1:0

# Override the starting source (optional - defaults to the first in AFI_SOURCES)
# export AFI_ACTIVE=zai

# --- reasoning effort --------------------------------------------------
# How hard the model is asked to think: low, medium, high, xhigh, or max.
# --effort wins over this. One name, translated per source - output_config on
# Anthropic, reasoning on OpenRouter, reasoning_effort on OpenAI - and capped at
# whatever the endpoint defines, which is `high` outside Anthropic. A source
# with no equivalent (llama.cpp, vLLM, SGLang, Z.ai) gets nothing and says so.
# Unlike EXTRA_BODY, an unusable value here stops the run instead of being
# ignored. Note individual models are stricter than their wire format:
# claude-haiku-4-5 takes no effort at all.
# export AFI_EFFORT=high

# --- token rates -------------------------------------------------------
# afi ships a rate table, refreshes it in the background at most once a day,
# and reports usage.cost_usd from it - nothing here is needed for a figure.
# What this table does is overrule those rates, class by class, for a model
# afi prices wrongly or has never heard of. Model id, no provider: a rate you
# wrote down is one you meant, whichever endpoint serves it.
# export AFI_PRICES='{"claude-sonnet-5":{"input":3,"output":15,"cache_read":0.3,"cache_write":3.75}}'
#
# Turn the background fetch off entirely. The shipped table and anything in
# AFI_PRICES still apply, so an air-gapped run still reports a cost.
# export AFI_PRICE_REFRESH=0
#
# Say so on stderr when the rates a run bills against are older than this many
# days. 0 says nothing. A stale rate produces exactly as confident a figure as
# a current one, and this line is the only difference a reader can see.
# export AFI_PRICE_STALE_DAYS=30

# --- spending cap ------------------------------------------------------
# What one run may spend, in USD. --budget-usd wins over this, and unset means
# no cap, which is what afi did before this existed.
#
# It is enforced by afi rather than by the model: the number never reaches the
# model as an instruction, because a budget in a prompt is text that anything
# else in the context can argue with. At 80% of the cap the model is told once
# to converge; at 95% the turn loop stops opening requests. Spending it ends
# the run successfully - exit 0, ok: true, and usage.budget saying so.
#
# afi caps what a run spends by pricing what it used, so a cap with no rates
# for the model this run uses exits 2 instead of starting under a cap that
# could never fire.
# export AFI_BUDGET_USD=5
# export AFI_SOFT_BUDGET_RATIO=0.8
# export AFI_HARD_BUDGET_RATIO=0.95
